# All settings use the COLDCHAIN_ prefix (see src/coldchain/config.py).

# SQLAlchemy database URL. Default: sqlite:///./coldchain.db
COLDCHAIN_DATABASE_URL=sqlite:///./coldchain.db

# Pepper mixed into API key hashes. Change in production.
COLDCHAIN_API_KEY_PEPPER=dev-pepper-change-me

# Webhook delivery: per-attempt timeout and max retry attempts.
COLDCHAIN_WEBHOOK_TIMEOUT_SECONDS=5.0
COLDCHAIN_WEBHOOK_MAX_ATTEMPTS=8

# Pagination defaults and caps.
COLDCHAIN_DEFAULT_PAGE_SIZE=50
COLDCHAIN_MAX_PAGE_SIZE=200

# Max items accepted by POST /v1/readings/batch.
COLDCHAIN_BATCH_MAX_ITEMS=500
